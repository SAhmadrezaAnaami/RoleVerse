APP_NAME=RoleVerse
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./roleverse.db
GOD_USER_PHONE=
AUTH_PEPPER=
SESSION_COOKIE_NAME=roleverse_session
SESSION_TTL_MINUTES=1440
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PROVIDER_FIXTURE_PATH=
PROVIDER_ALLOWED_HOSTS=
LIVE_PROVIDER_ENABLED=false
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_OUTPUT_TOKENS=512
PROVIDER_INPUT_PRICE_MICRO_PER_MILLION=0
PROVIDER_OUTPUT_PRICE_MICRO_PER_MILLION=0
GENERATION_RATE_LIMIT_PER_USER=20
GENERATION_RATE_LIMIT_GLOBAL=100
GENERATION_RATE_LIMIT_WINDOW_SECONDS=60
